# ── Copy this file to .env and fill in your values ──────────────────────────
# NEVER commit .env to git

# MongoDB Atlas connection string
MONGODB_URI=PASTE_YOUR_MONGODB_ATLAS_URI_HERE

# JWT secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX

# JWT expiry
JWT_EXPIRES_IN=8h

# Port (Render sets this automatically)
PORT=4000

# Frontend origin — set to your Render static site URL after deploying frontend
FRONTEND_ORIGIN=http://localhost:5173

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=abvjgsog
CLOUDINARY_API_KEY=PASTE_YOUR_CLOUDINARY_API_KEY_HERE
CLOUDINARY_API_SECRET=PASTE_YOUR_CLOUDINARY_API_SECRET_HERE
